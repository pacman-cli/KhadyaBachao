# Khadya Bachao mobile — copy to .env (gitignored) and fill in.

# Backend URL: Android emulator reaches the host machine via 10.0.2.2.
# Physical device: use your computer's LAN IP (ipconfig getifaddr en0).
API_BASE_URL=http://10.0.2.2:8080

# Google Maps SDK key (Android) — restrict by package com.khadyabachao + SHA-1.
# NOTE: the gradle build reads it from ~/.gradle/gradle.properties or
# GOOGLE_MAPS_API_KEY env instead — this copy is for reference/runtime use.
GOOGLE_MAPS_API_KEY=

# Google Sign-In: Firebase Console → Authentication → Google → Web client ID
# (required for real Google login; the value below is only a placeholder).
GOOGLE_WEB_CLIENT_ID=

# true = real Firebase auth + FCM push. Leave unset/empty for dev fallback.
FIREBASE_ENABLED=
