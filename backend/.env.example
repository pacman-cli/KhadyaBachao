# Khadya Bachao backend — copy to .env.local (gitignored) and fill in.
# Everything below has a working default for local dev EXCEPT the marked ones.

# --- Database (docker compose up -d postgres uses these defaults) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=khadyabachao
DB_USER=khadya
DB_PASSWORD=khadya

# --- Server ---
SERVER_PORT=8080
# REQUIRED in production: 64+ random chars (openssl rand -base64 64).
# Local dev with SPRING_PROFILES_ACTIVE=dev may omit this.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Firebase (real auth + FCM push) ---
# REQUIRED for production. Dev mode (no Firebase) works without these:
# POST /api/auth/dev/login replaces real auth locally.
FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# --- Image storage: local | r2 | firebase ---
# local (default) needs nothing below. R2 free tier: 10GB/mo.
STORAGE_PROVIDER=r2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=khadya-bachao-uploads
CLOUDFLARE_R2_PUBLIC_URL_PREFIX=https://pub-xxxxxxxx.r2.dev

# --- CORS / logging / rate limits ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=INFO
# Raise for load tests; default 20 writes+auth requests/min per IP.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
